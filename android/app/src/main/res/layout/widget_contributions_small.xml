<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@color/widget_background">

    <TextView
        android:id="@+id/widget_contrib_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/widget_text"
        android:text="Activity" />

    <TextView
        android:id="@+id/widget_contrib_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="11sp"
        android:textColor="@color/widget_muted"
        android:text="0 days" />

    <FrameLayout
        android:id="@+id/widget_contrib_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@color/widget_border" />

    <LinearLayout
        android:id="@+id/widget_contrib_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_contrib_cell_0"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="8sp"
            android:textColor="@color/widget_text"
            android:background="@android:color/transparent"
            android:padding="0dp" />
        <TextView
            android:id="@+id/widget_contrib_cell_1"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="8sp"
            android:textColor="@color/widget_text"
            android:background="@android:color/transparent"
            android:padding="0dp" />
        <TextView
            android:id="@+id/widget_contrib_cell_2"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="8sp"
            android:textColor="@color/widget_text"
            android:background="@android:color/transparent"
            android:padding="0dp" />
        <TextView
            android:id="@+id/widget_contrib_cell_3"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="8sp"
            android:textColor="@color/widget_text"
            android:background="@android:color/transparent"
            android:padding="0dp" />
        <TextView
            android:id="@+id/widget_contrib_cell_4"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="8sp"
            android:textColor="@color/widget_text"
            android:background="@android:color/transparent"
            android:padding="0dp" />
        <TextView
            android:id="@+id/widget_contrib_cell_5"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="8sp"
            android:textColor="@color/widget_text"
            android:background="@android:color/transparent"
            android:padding="0dp" />
        <TextView
            android:id="@+id/widget_contrib_cell_6"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="8sp"
            android:textColor="@color/widget_text"
            android:background="@android:color/transparent"
            android:padding="0dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/widget_contrib_open"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="10sp"
        android:textColor="@color/widget_muted"
        android:text="Tap to open analytics" />

</LinearLayout>
