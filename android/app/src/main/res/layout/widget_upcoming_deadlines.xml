<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@color/widget_background">

    <TextView
        android:id="@+id/widget_deadlines_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/widget_text"
        android:text="Upcoming Deadlines" />

    <FrameLayout
        android:id="@+id/widget_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@color/widget_border" />

    <TextView
        android:id="@+id/widget_deadline_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/widget_text"
        android:text="No upcoming deadlines" />

    <TextView
        android:id="@+id/widget_deadline_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/widget_muted"
        android:text="" />

    <TextView
        android:id="@+id/widget_deadline_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/widget_muted"
        android:text="" />

    <TextView
        android:id="@+id/widget_deadlines_open"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/widget_muted"
        android:layout_marginTop="8dp"
        android:text="Tap to open deadlines" />

</LinearLayout>
