<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/AppTheme">

        <!--
          MainActivity is the one and only launcher entry. The previous build
          switched launcher icons by enabling/disabling activity-alias entries
          at runtime. That left the home-screen shortcut pointing at a disabled
          component (which opens Android "App info" instead of the app) and
          could interrupt the running task when the theme changed. A single
          stable launcher activity removes both failure modes.
        -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density|fontScale"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="studyzone" android:host="app" />
            </intent-filter>

            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Home Screen Widgets (five independent providers) -->
        <receiver
            android:name=".StudyZoneTodayTasksWidget"
            android:label="@string/widget_today_tasks"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.studyzone.app.action.UPDATE_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <receiver
            android:name=".StudyZoneLargeTasksWidget"
            android:label="@string/widget_large_tasks"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.studyzone.app.action.UPDATE_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_large" />
        </receiver>

        <receiver
            android:name=".StudyZoneDailyProgressWidget"
            android:label="@string/widget_daily_progress"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.studyzone.app.action.UPDATE_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_progress" />
        </receiver>

        <receiver
            android:name=".StudyZoneFocusWidget"
            android:label="@string/widget_focus"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.studyzone.app.action.UPDATE_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_focus" />
        </receiver>

        <receiver
            android:name=".StudyZoneUpcomingDeadlinesWidget"
            android:label="@string/widget_upcoming_deadlines"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.studyzone.app.action.UPDATE_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_deadlines" />
        </receiver>

        <receiver
            android:name=".StudyZoneContributionsWidgetSmall"
            android:label="@string/widget_contributions_small"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.studyzone.app.action.UPDATE_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_contributions_small" />
        </receiver>

        <receiver
            android:name=".StudyZoneContributionsWidgetMedium"
            android:label="@string/widget_contributions_medium"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.studyzone.app.action.UPDATE_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_contributions_medium" />
        </receiver>

        <receiver
            android:name=".StudyZoneContributionsWidgetLarge"
            android:label="@string/widget_contributions_large"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.studyzone.app.action.UPDATE_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_contributions_large" />
        </receiver>

        <!-- Native live clock widget. TextClock ticks itself in the launcher;
             no background service and no per-second app wake-ups. -->
        <receiver
            android:name=".StudyZoneClockWidget"
            android:label="@string/widget_clock"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.studyzone.app.action.REFRESH_CLOCK_WIDGET" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_clock" />
        </receiver>

        <!-- Restores the clock notification after reboot and implements its
             "Turn off" action. -->
        <receiver
            android:name=".StudyZoneBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="com.studyzone.app.action.DISABLE_CLOCK_NOTIFICATION" />
            </intent-filter>
        </receiver>

        <!-- WhatsApp-like incoming call UI and actions. -->
        <activity
            android:name=".IncomingCallActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/AppTheme.NoActionBar" />

        <receiver
            android:name=".IncomingCallReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.studyzone.app.action.CALL_ACCEPT" />
                <action android:name="com.studyzone.app.action.CALL_DECLINE" />
                <action android:name="com.studyzone.app.action.CALL_DISMISS" />
            </intent-filter>
        </receiver>

        <!-- End-call action + return-to-call action for the foreground service. -->
        <receiver
            android:name=".StudyZoneCallActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.studyzone.app.action.CALL_END" />
            </intent-filter>
        </receiver>

        <!-- Active call: keeps audio/WebRTC alive in the background and gives the
             user a persistent notification with a return and an end action.
             It is started only by the web layer when a call really begins. -->
        <service
            android:name=".StudyZoneCallService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera" />

        <!-- Screen capture: foreground service required by Android for MediaProjection. -->
        <service
            android:name=".StudyZoneScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <service
            android:name=".StudyZoneFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />

    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Foreground service for the active call (microphone/camera while the
         user is really in a call). Not used for anything else. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Team Live video calls. Optional so devices without a camera can still
         install and use audio calls. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Incoming call alerts: full-screen intent (where permitted), vibration and wake. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- No foreground service is used: the persistent clock notification is a
         normal ongoing notification driven by the system chronometer. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
</manifest>
